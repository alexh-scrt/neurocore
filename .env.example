# NeuroCore Environment Variables
# Copy this file to .env and fill in your values.

# Logging
# NEUROCORE_LOGGING__LEVEL=INFO
# NEUROCORE_LOGGING__FORMAT=console

# Skill-specific config (passed through to skills)
# NEUROCORE_SKILLS__NEUROWEAVE__LLM_API_KEY=sk-ant-...
# NEUROCORE_SKILLS__NEUROWEAVE__LLM_PROVIDER=anthropic
